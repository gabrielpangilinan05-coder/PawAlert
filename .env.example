# Local env — copy to .env.local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=pawalert

# Or use a single URL (Vercel / Railway / Aiven MySQL):
# DATABASE_URL=mysql://user:pass@host:3306/pawalert
# DATABASE_SSL=true

SESSION_SECRET=pawalert-dev-session-secret-change-me-32chars
# On Vercel set NEXT_PUBLIC_APP_URL to your production URL, e.g.:
# NEXT_PUBLIC_APP_URL=https://pawalert-ecru.vercel.app
# After you attach a custom domain:
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# —— Email OTP (Gmail SMTP) ——
# Local: keep MAIL_DEV_MODE=true so codes log to the server console / verify UI (no SMTP).
MAIL_DEV_MODE=true
# Production (Vercel): set MAIL_DEV_MODE=false and add Gmail App Password credentials:
#   1. Google Account → Security → 2-Step Verification ON
#   2. App passwords → create one for "Mail"
#   3. Vercel → Project → Settings → Environment Variables:
#        MAIL_DEV_MODE=false
#        SMTP_USER=youremail@gmail.com
#        SMTP_PASS=xxxx xxxx xxxx xxxx
#        EMAIL_FROM=PawAlert <youremail@gmail.com>
# Optional overrides (defaults are Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM=PawAlert <youremail@gmail.com>

# Optional: comma-separated emails that get admin access (also synced to users.role)
# ADMIN_EMAILS=you@example.com

# Optional: override uploads directory (default: ./uploads in project root)
# UPLOAD_ROOT=c:\xampp\htdocs\pawalert-next\uploads

# Vercel Blob (production photo/video storage). When set, uploads go to Blob instead of disk.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
